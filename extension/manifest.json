{
  "manifest_version": 3,
  "name": "Odyssey • Read Later & Pure Prose Purifier",
  "short_name": "Odyssey",
  "version": "1.0.0",
  "description": "One-click article purification and instant sync with your Odysseus slow-journalism salon and offline reading chamber.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Odyssey — Save to Salon",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options/options.html",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+O",
        "mac": "MacCtrl+Shift+O"
      },
      "description": "Open Odyssey Companion popup"
    },
    "quick-save": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "Instantly save current page to Odysseus Salon"
    }
  }
}
